# Database URL (PostgreSQL; override if needed)
DATABASE_URL=postgres://postgres:postgres@localhost/halal

# Debug builds (cargo run, no --release) automatically cap each letter's crawl
# at 1 page so local runs stay fast. Override the cap with HALAL_MAX_PAGES=N,
# or set HALAL_MAX_PAGES=0 to disable it entirely (full crawl even in debug).
HALAL_MAX_PAGES=1
