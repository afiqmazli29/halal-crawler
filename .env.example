# Database URL (PostgreSQL; override if needed)
DATABASE_URL=postgres://postgres:postgres@localhost/halal

# Debug builds (cargo run, no --release) automatically cap each letter's crawl
# at 1 page so local runs stay fast. Override the cap with HALAL_MAX_PAGES=N,
# or set HALAL_MAX_PAGES=0 to disable it entirely (full crawl even in debug).
HALAL_MAX_PAGES=1

# Read-only API (cargo run --bin halal-api).
# Address to bind; defaults to loopback port 8080 when unset.
# Set this when the API must listen on another interface or port.
# API_BIND=ip:port

# Comma-separated CORS allowlist. Defaults to "*" (any origin); the API is
# read-only and credential-free.
# API_CORS_ORIGINS=https://example.com,https://admin.example.com

# Tracing filter for the API (and the crawler if it ever adopts tracing).
# RUST_LOG=info,tower_http=debug
